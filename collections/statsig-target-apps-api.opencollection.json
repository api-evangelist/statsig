{
  "opencollection": "1.0.0",
  "info": {
    "name": "Statsig Client SDK Audit Logs Target Apps API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "statsig-api-key",
      "value": "{{statsig-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Target Apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all target apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.statsig.com/v1/target_apps",
            "headers": [
              {
                "name": "STATSIG-API-VERSION",
                "value": ""
              }
            ]
          },
          "docs": "Retrieves a list of all target application definitions in the project."
        }
      ]
    }
  ],
  "bundled": true
}
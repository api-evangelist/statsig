            "method": "PUT",
            "url": "https://api.statsig.com/v1/gates/:id/enable",
            "headers": [
              {
                "name": "STATSIG-API-VERSION",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The name or identifier of the feature gate."
              }
            ]
          },
          "docs": "Enables a feature gate so that its rules are actively evaluated for users."
        },
        {
          "info": {
            "name": "Disable a gate",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.statsig.com/v1/gates/:id/disable",
            "headers": [
              {
                "name": "STATSIG-API-VERSION",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The name or identifier of the feature gate."
              }
            ]
          },
          "docs": "Disables a feature gate so that it returns false for all users regardless of rules."
        },
        {
          "info": {
            "name": "Launch a gate",
            "type": "http"

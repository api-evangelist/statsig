              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The name or identifier of the feature gate."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates specific fields of a feature gate without replacing the entire configuration."
        },
        {
          "info": {
            "name": "Delete a gate",
            "type": "http"
          },

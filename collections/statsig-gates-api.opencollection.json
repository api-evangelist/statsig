{
  "opencollection": "1.0.0",
  "info": {
    "name": "Statsig Client SDK Audit Logs Gates API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "statsig-api-key",
      "value": "{{statsig-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Gates",
